@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5"
     style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)">
    <div class="card border-0 shadow-lg" style="width:100%;max-width:420px">
        <div class="card-body p-5">

            <!-- Logo / Header -->
            <div class="text-center mb-4">
                <div class="fs-1 mb-2">💈</div>
                <h3 class="fw-bold text-dark">Barbershop's Ibarra</h3>
                <p class="text-muted small">Ingresa a tu cuenta</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <form id="account" method="post">

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold">Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control form-control-lg"
                           autocomplete="username" placeholder="tu@correo.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold">Contraseña</label>
                    <input asp-for="Input.Password" class="form-control form-control-lg"
                           autocomplete="current-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <label class="d-flex align-items-center gap-2 text-muted small">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        Recordarme
                    </label>
                    <a asp-page="./ForgotPassword" class="text-primary small">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold mb-3">
                    Iniciar Sesión
                </button>

                <div class="text-center">
                    <span class="text-muted small">¿No tienes cuenta?</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
                       class="text-primary small fw-semibold ms-1">Regístrate aquí</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}