@model IEnumerable<ModelosBarberia.LogSistema>
@{
    ViewData["Title"] = "Logs de Sistema";
}

<div class="container-fluid my-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">📋 Logs de Sistema</h2>
        <span class="badge bg-secondary fs-6">@Model.Count() registros</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <div class="fs-1">📭</div>
            <p>No hay logs registrados.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Mensaje</th>
                                <th>Entidad</th>
                                <th>Usuario</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.OrderByDescending(l => l.Fecha))
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        <small>@log.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        @{
                                            var badge = log.Tipo?.ToLower() switch
                                            {
                                                "error" => "danger",
                                                "warning" => "warning",
                                                "info" => "info",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@badge">@log.Tipo</span>
                                    </td>
                                    <td style="max-width:250px">
                                        <small class="text-truncate d-block" style="max-width:250px"
                                               title="@log.Mensaje">
                                            @log.Mensaje
                                        </small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(log.Entidad))
                                        {
                                            <span class="badge bg-light text-dark">@log.Entidad</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@log.UsuarioId</small>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@log.Id"
                                           class="btn btn-sm btn-outline-primary">Ver</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>