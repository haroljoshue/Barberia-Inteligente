@model ModelosBarberia.LogSistema
@{
    ViewData["Title"] = "Detalle Log Sistema";
}

<div class="container my-4" style="max-width:800px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">📋 Detalle Log Sistema</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-muted mb-0">Información General</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small">Fecha</label>
                    <p class="mb-0 fw-bold">@Model.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Tipo</label>
                    <p class="mb-0">
                        @{
                            // Mapeo corregido usando los nombres reales de tu enum en español
                            var badge = Model.Tipo switch
                            {
                                ModelosBarberia.Enum.TipoLogSistema.Error => "danger",
                                ModelosBarberia.Enum.TipoLogSistema.Critico => "danger",
                                ModelosBarberia.Enum.TipoLogSistema.Advertencia => "warning",
                                ModelosBarberia.Enum.TipoLogSistema.Informacion => "info",
                                ModelosBarberia.Enum.TipoLogSistema.Operacion => "success",
                                _ => "secondary"
                            };
                        }
                        <span class="badge bg-@badge">@Model.Tipo</span>
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Entidad</label>
                    <p class="mb-0 fw-bold">@(Model.Entidad ?? "—")</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Entidad ID</label>
                    <p class="mb-0 fw-bold">@(Model.EntidadId ?? "—")</p>
                </div>
                <div class="col-md-12">
                    <label class="text-muted small">Usuario ID</label>
                    <p class="mb-0 fw-bold">@(Model.UsuarioId ?? "—")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-muted mb-0">💬 Mensaje</h6>
        </div>
        <div class="card-body">
            <p class="mb-0">@(Model.Mensaje ?? "—")</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StackTrace))
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-danger text-white border-0 pt-3">
                <h6 class="mb-0">🔍 Stack Trace</h6>
            </div>
            <div class="card-body bg-dark text-light rounded-bottom">
                <pre class="mb-0 small" style="white-space:pre-wrap">@Model.StackTrace</pre>
            </div>
        </div>
    }
</div>