@model Barberia.MVC.Controllers.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Administrativo";

    string Numero(double valor, int decimales = 2)
    {
        return valor.ToString($"N{decimales}");
    }

    string Porcentaje(double valor)
    {
        return valor.ToString("N2") + "%";
    }
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Dashboard Administrativo</h1>
        <p class="text-muted mb-0">
            Resumen general del sistema de Barbería Inteligente.
        </p>
    </div>

    <!-- ========================= -->
    <!-- RESUMEN GENERAL -->
    <!-- ========================= -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total de citas</p>
                    <h3>@Model.TotalCitas</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Citas de hoy</p>
                    <h3>@Model.CitasHoy</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Citas pendientes</p>
                    <h3>@Model.CitasPendientes</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Usuarios registrados</p>
                    <h3>@Model.TotalUsuarios</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total barberos</p>
                    <h3>@Model.TotalBarberos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total servicios</p>
                    <h3>@Model.TotalServicios</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Citas con vector</p>
                    <h3>@Model.CitasConVector</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Citas sin vector</p>
                    <h3>@Model.CitasSinVector</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- ========================= -->
    <!-- VECTOR DB -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h5 class="mb-0">Vectorización de citas</h5>
                    <small class="text-muted">
                        Citas que ya tienen embedding almacenado en Qdrant.
                    </small>
                </div>
                <strong>@Porcentaje(Model.PorcentajeVectorizacion)</strong>
            </div>

            <div class="progress" style="height: 22px;">
                <div class="progress-bar"
                     role="progressbar"
                     style="width: @Model.PorcentajeVectorizacion.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                    @Porcentaje(Model.PorcentajeVectorizacion)
                </div>
            </div>

            <div class="row text-center mt-3">
                <div class="col-md-4">
                    <span class="text-muted">Total citas</span>
                    <h5>@Model.TotalCitas</h5>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Con vector</span>
                    <h5>@Model.CitasConVector</h5>
                </div>
                <div class="col-md-4">
                    <span class="text-muted">Sin vector</span>
                    <h5>@Model.CitasSinVector</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================= -->
    <!-- AGENTE -->
    <!-- ========================= -->
    <h4 class="mb-3">Agente inteligente</h4>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Consultas totales</p>
                    <h3>@Model.TotalConsultasAgente</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Consultas exitosas</p>
                    <h3>@Model.ConsultasExitosasAgente</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Consultas con error</p>
                    <h3>@Model.ConsultasErrorAgente</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Consultas sin resultados</p>
                    <h3>@Model.ConsultasSinResultados</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Tiempo promedio</p>
                    <h3>@Numero(Model.TiempoPromedioRespuestaAgente) ms</h3>
                    <small class="text-muted">Ignora valores en cero.</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Tokens promedio</p>
                    <h3>@Numero(Model.TokensPromedioAgente)</h3>
                    <small class="text-muted">Ignora valores en cero.</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Similitud promedio</p>
                    <h3>@Numero(Model.SimilitudPromedioAgente, 4)</h3>
                    <small class="text-muted">Ignora valores en cero.</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Similitud máxima</p>
                    <h3>@Numero(Model.SimilitudMaximaAgente, 4)</h3>
                    <small class="text-muted">Ignora valores en cero.</small>
                </div>
            </div>
        </div>

    </div>

    <!-- ========================= -->
    <!-- LOGS SISTEMA -->
    <!-- ========================= -->
    <h4 class="mb-3">Logs del sistema</h4>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total logs</p>
                    <h3>@Model.TotalLogsSistema</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Exitosos</p>
                    <h3>@Model.LogsSistemaExitosos</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Errores</p>
                    <h3>@Model.LogsSistemaError</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Latencia promedio</p>
                    <h3>@Numero(Model.LatenciaPromedioSistema) ms</h3>
                    <small class="text-muted">Ignora valores en cero.</small>
                </div>
            </div>
        </div>

    </div>

    <!-- ========================= -->
    <!-- DISTRIBUCIONES -->
    <!-- ========================= -->
    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Reservas por servicio</h5>
                </div>
                <div class="card-body">
                    @if (Model.ReservasPorServicio.Any())
                    {
                        foreach (var item in Model.ReservasPorServicio.OrderByDescending(x => x.Value))
                        {
                            var porcentaje = Model.TotalCitas == 0
                            ? 0
                            : Math.Round((double)item.Value / Model.TotalCitas * 100, 2);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <strong>@item.Value</strong>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar"
                                         style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay reservas por servicio para mostrar.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Usuarios por rol</h5>
                </div>
                <div class="card-body">
                    @if (Model.UsuariosPorRol.Any())
                    {
                        foreach (var item in Model.UsuariosPorRol.OrderByDescending(x => x.Value))
                        {
                            var porcentaje = Model.TotalUsuarios == 0
                            ? 0
                            : Math.Round((double)item.Value / Model.TotalUsuarios * 100, 2);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <strong>@item.Value</strong>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar"
                                         style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay usuarios por rol para mostrar.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Herramientas usadas por el agente</h5>
                </div>
                <div class="card-body">
                    @if (Model.HerramientasUsadas.Any())
                    {
                        foreach (var item in Model.HerramientasUsadas.OrderByDescending(x => x.Value))
                        {
                            var porcentaje = Model.TotalConsultasAgente == 0
                            ? 0
                            : Math.Round((double)item.Value / Model.TotalConsultasAgente * 100, 2);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <strong>@item.Value</strong>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar"
                                         style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Todavía no hay herramientas registradas por el agente.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Consultas por tipo</h5>
                </div>
                <div class="card-body">
                    @if (Model.ConsultasPorTipo.Any())
                    {
                        foreach (var item in Model.ConsultasPorTipo.OrderByDescending(x => x.Value))
                        {
                            var porcentaje = Model.TotalConsultasAgente == 0
                            ? 0
                            : Math.Round((double)item.Value / Model.TotalConsultasAgente * 100, 2);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <strong>@item.Value</strong>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar"
                                         style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">Todavía no hay tipos de consulta registrados.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Logs del sistema por tipo</h5>
                </div>
                <div class="card-body">
                    @if (Model.LogsSistemaPorTipo.Any())
                    {
                        foreach (var item in Model.LogsSistemaPorTipo.OrderByDescending(x => x.Value))
                        {
                            var porcentaje = Model.TotalLogsSistema == 0
                            ? 0
                            : Math.Round((double)item.Value / Model.TotalLogsSistema * 100, 2);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <strong>@item.Value</strong>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar"
                                         style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay logs por tipo para mostrar.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Logs del sistema por entidad</h5>
                </div>
                <div class="card-body">
                    @if (Model.LogsSistemaPorEntidad.Any())
                    {
                        foreach (var item in Model.LogsSistemaPorEntidad.OrderByDescending(x => x.Value))
                        {
                            var porcentaje = Model.TotalLogsSistema == 0
                            ? 0
                            : Math.Round((double)item.Value / Model.TotalLogsSistema * 100, 2);

                            <div class="mb-3">
                                <div class="d-flex justify-content-between">
                                    <span>@item.Key</span>
                                    <strong>@item.Value</strong>
                                </div>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar"
                                         style="width: @porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%;">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No hay logs por entidad para mostrar.</p>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- ========================= -->
    <!-- CITAS POR CLIENTE -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Citas por cliente</h5>
        </div>
        <div class="card-body">
            @if (Model.CitasPorCliente.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ClienteId</th>
                                <th class="text-end">Cantidad de citas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CitasPorCliente.OrderByDescending(x => x.Value))
                            {
                                <tr>
                                    <td>@item.Key</td>
                                    <td class="text-end">
                                        <span class="badge bg-primary">@item.Value</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No hay citas asociadas a clientes.</p>
            }
        </div>
    </div>

    <!-- ========================= -->
    <!-- ÚLTIMOS LOGS DEL AGENTE -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Últimos logs del agente</h5>
            <span class="badge bg-secondary">@Model.UltimosLogsAgente.Count registros</span>
        </div>
        <div class="card-body">
            @if (Model.UltimosLogsAgente.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Tipo</th>
                                <th>Pregunta</th>
                                <th>Herramienta</th>
                                <th>Resultados</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.UltimosLogsAgente)
                            {
                                <tr>
                                    <td>@log.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@log.UsuarioId</td>
                                    <td>@log.Tipo</td>
                                    <td style="max-width: 350px;">
                                        @{
                                            var pregunta = log.Pregunta ?? "";
                                            var preguntaCorta = pregunta.Length > 80
                                            ? pregunta.Substring(0, 80) + "..."
                                            : pregunta;
                                        }
                                        <span title="@pregunta">@preguntaCorta</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.HerramientaUsada))
                                        {
                                            <span class="badge bg-info text-dark">@log.HerramientaUsada</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @(log.CantidadResultados.HasValue? log.CantidadResultados.Value.ToString() : "N/A")
                                    </td>
                                    <td>
                                        @if (log.ConsultaExitosa && string.IsNullOrWhiteSpace(log.MensajeError))
                                        {
                                            <span class="badge bg-success">Exitosa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Error</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Todavía no hay logs del agente registrados.
                </p>
            }
        </div>
    </div>

    <!-- ========================= -->
    <!-- ÚLTIMOS LOGS DEL SISTEMA -->
    <!-- ========================= -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Últimos logs del sistema</h5>
            <span class="badge bg-secondary">@Model.UltimosLogsSistema.Count registros</span>
        </div>
        <div class="card-body">
            @if (Model.UltimosLogsSistema.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Mensaje</th>
                                <th>Entidad</th>
                                <th>EntidadId</th>
                                <th>Latencia</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.UltimosLogsSistema)
                            {
                                <tr>
                                    <td>@log.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@log.Tipo</td>
                                    <td style="max-width: 420px;">
                                        @{
                                            var mensaje = log.Mensaje ?? "";
                                            var mensajeCorto = mensaje.Length > 90
                                            ? mensaje.Substring(0, 90) + "..."
                                            : mensaje;
                                        }
                                        <span title="@mensaje">@mensajeCorto</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.Entidad))
                                        {
                                            @log.Entidad
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(log.EntidadId))
                                        {
                                            @log.EntidadId
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.LatenciaMs.HasValue && log.LatenciaMs.Value > 0)
                                        {
                                            <span>@log.LatenciaMs ms</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (log.Exitoso)
                                        {
                                            <span class="badge bg-success">Exitoso</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Error</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No hay logs del sistema registrados.
                </p>
            }
        </div>
    </div>

</div>