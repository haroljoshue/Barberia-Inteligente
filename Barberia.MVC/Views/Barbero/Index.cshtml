@model ModelosBarberia.ViewModels.BarberoDashboardViewModel
@using ModelosBarberia.Enum  
@using ModelosBarberia       
@{
    ViewData["Title"] = "Panel del Barbero";
}

<div class="container-fluid my-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-0">💈 Panel del Barbero</h2>
            <small class="text-muted">Bienvenido, @User.Identity?.Name</small>
        </div>
        <span class="badge bg-primary fs-6">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-5">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-1">📋</div>
                    <div class="fs-2 fw-bold text-primary">@Model.Citas.Count</div>
                    <div class="text-muted small">Total Citas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-1">📅</div>
                    <div class="fs-2 fw-bold text-success">@Model.CitasHoy</div>
                    <div class="text-muted small">Citas Hoy</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-1">⏳</div>
                    <div class="fs-2 fw-bold text-warning">@Model.CitasPendientes</div>
                    <div class="text-muted small">Pendientes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-1">✅</div>
                    <div class="fs-2 fw-bold text-info">@Model.CitasCompletadas</div>
                    <div class="text-muted small">Completadas</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-5">
        <div class="card-header bg-white border-0 pt-3">
            <h5 class="text-primary mb-0">✂️ Mis Citas</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Citas.Any())
            {
                <div class="text-center text-muted py-5">No tienes citas registradas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Cliente</th>
                                <th>Servicio</th>
                                <th>Fecha y Hora</th>
                                <th>Estado</th>
                                <th>Observación</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model.Citas.OrderBy(c => c.FechaHora))
                            {
                                <tr>
                                    <td>@(cita.Cliente?.NombreCompleto ?? "—")</td>
                                    <td>@(cita.Servicio?.Nombre ?? "—")</td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            var badge = cita.Estado switch
                                            {
                                                EstadoCita.Pendiente => "warning",
                                                EstadoCita.Confirmada => "info",
                                                EstadoCita.Atendida => "success",
                                                EstadoCita.Cancelada => "danger",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@badge">@cita.Estado</span>
                                    </td>
                                    <td>@(cita.Observacion ?? "—")</td>
                                    <td>
                                        <form asp-action="CambiarEstado" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="citaId" value="@cita.Id" />
                                            <select name="nuevoEstado" class="form-select form-select-sm">
                                                @foreach (EstadoCita estado in Enum.GetValues(typeof(EstadoCita)))
                                                {
                                                    <option value="@estado" selected="@(cita.Estado == estado)">
                                                        @estado
                                                    </option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-primary">✓</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3">
            <h5 class="text-primary mb-0">👥 Top Clientes</h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.TopClientes.Any())
            {
                <div class="text-center text-muted py-4">Sin datos de clientes aún.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Cliente</th>
                                <th>Email</th>
                                <th>Citas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (var cliente in Model.TopClientes)
                            {
                                <tr>
                                    <td>
                                        @if (rank == 1) { <span>🥇</span> }
                                        else if (rank == 2) { <span>🥈</span> }
                                        else if (rank == 3) { <span>🥉</span> }
                                        else { <span>@rank</span> }
                                    </td>
                                    <td>@cliente.NombreCompleto</td>
                                    <td>@cliente.Email</td>
                                    <td><span class="badge bg-primary">@cliente.Citas?.Count</span></td>
                                </tr>
                                @{ rank++; } @* <-- CORRECCIÓN: Operación de C# encerrada de forma explícita *@
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>