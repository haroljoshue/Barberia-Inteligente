@model ModelosBarberia.ViewModels.BarberoDashboardViewModel

@{
    ViewData["Title"] = "Panel del Barbero";
}

<div class="container my-5">
    <h2 class="mb-4 text-primary">Panel del Barbero</h2>

    <!-- Sección de citas -->
    <h4>Citas</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cita in Model.Citas)
            {
                <tr>
                    <td>@cita.Cliente.NombreCompleto</td>
                    <td>@cita.Servicio.Nombre</td>
                    <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@cita.Estado</td>
                    <td>
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="citaId" value="@cita.Id" />
                            <select name="nuevoEstado" class="form-select form-select-sm d-inline w-auto">
                                @foreach (var estado in Enum.GetValues(typeof(ModelosBarberia.Enum.EstadoCita)))
                                {
                                    <option value="@estado" selected="@(cita.Estado == (ModelosBarberia.Enum.EstadoCita)estado)">
                                        @estado
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Actualizar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Sección de top clientes -->
    <h4 class="mt-5">Top Clientes</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Cliente</th>
                <th>Número de Citas</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model.TopClientes)
            {
                <tr>
                    <td>@cliente.NombreCompleto</td>
                    <td>@cliente.Citas.Count</td>
                </tr>
            }
        </tbody>
    </table>
</div>
