@model ModelosBarberia.ViewModels.BarberoDashboardViewModel
@using ModelosBarberia.Enum
@using ModelosBarberia

@{
    ViewData["Title"] = "Panel del Barbero";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <span class="text-danger">💈</span> Panel del Barbero
            </h2>
            <p class="text-muted mb-0">Bienvenido, @User.Identity?.Name</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill bg-dark px-3 py-2">
                <i class="bi bi-calendar3 me-1"></i>
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 stat-card">
                <div class="card-body text-center py-4">
                    <div class="stat-icon bg-primary-subtle text-primary mb-3">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.Citas.Count</h3>
                    <p class="text-muted mb-0">Total Citas</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 stat-card">
                <div class="card-body text-center py-4">
                    <div class="stat-icon bg-success-subtle text-success mb-3">
                        <i class="bi bi-calendar-event"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.CitasHoy</h3>
                    <p class="text-muted mb-0">Citas Hoy</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 stat-card">
                <div class="card-body text-center py-4">
                    <div class="stat-icon bg-warning-subtle text-warning mb-3">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.CitasPendientes</h3>
                    <p class="text-muted mb-0">Pendientes</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 stat-card">
                <div class="card-body text-center py-4">
                    <div class="stat-icon bg-info-subtle text-info mb-3">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.CitasCompletadas</h3>
                    <p class="text-muted mb-0">Completadas</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-scissors me-2 text-danger"></i>Mis Citas
            </h5>
        </div>

        <div class="card-body p-0">
            @if (!Model.Citas.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-4 text-muted"></i>
                    <p class="text-muted mt-3 mb-0">No tienes citas registradas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Servicio</th>
                                <th>Fecha y hora</th>
                                <th>Estado</th>
                                <th>Observación</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model.Citas.OrderBy(c => c.FechaHora))
                            {
                                string badge = cita.Estado switch
                                {
                                    EstadoCita.Pendiente => "warning",
                                    EstadoCita.Confirmada => "info",
                                    EstadoCita.Atendida => "success",
                                    EstadoCita.Cancelada => "danger",
                                    _ => "secondary"
                                };

                                <tr>
                                    <td class="fw-semibold">@(cita.Cliente?.NombreCompleto ?? "—")</td>
                                    <td>@(cita.Servicio?.Nombre ?? "—")</td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-@badge rounded-pill px-3 py-2">
                                            @cita.Estado
                                        </span>
                                    </td>
                                    <td class="text-muted">@(!string.IsNullOrWhiteSpace(cita.Observacion) ? cita.Observacion : "—")</td>
                                    <td>
                                        <form asp-action="CambiarEstado" method="post" class="d-flex gap-2 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="citaId" value="@cita.Id" />

                                            <select name="nuevoEstado" class="form-select form-select-sm" style="max-width: 180px;">
                                                @foreach (EstadoCita estado in Enum.GetValues(typeof(EstadoCita)))
                                                {
                                                    if (cita.Estado == estado)
                                                    {
                                                        <option value="@estado" selected>@estado</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@estado">@estado</option>
                                                    }
                                                }
                                            </select>

                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-people me-2 text-danger"></i>Top Clientes
            </h5>
        </div>

        <div class="card-body p-0">
            @if (!Model.TopClientes.Any())
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-people display-6 d-block mb-2"></i>
                    Sin datos de clientes aún.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Cliente</th>
                                <th>Email</th>
                                <th>Citas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }

                            @foreach (var cliente in Model.TopClientes)
                            {
                                <tr>
                                    <td>
                                        @(rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : rank.ToString())
                                    </td>
                                    <td class="fw-semibold">@cliente.NombreCompleto</td>
                                    <td>@cliente.Email</td>
                                    <td>
                                        <span class="badge bg-dark rounded-pill px-3 py-2">
                                            @(cliente.Citas?.Count ?? 0)
                                        </span>
                                    </td>
                                </tr>
                                @: @{
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>