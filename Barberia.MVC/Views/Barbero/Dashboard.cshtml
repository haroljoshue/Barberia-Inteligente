@model ModelosBarberia.ViewModels.BarberoDashboardViewModel
@{
    ViewData["Title"] = "Dashboard del Barbero";
}

<div class="container mt-4">

    <!-- Encabezado con botón actualizar -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
        <h2 class="mb-0">Panel de Control</h2>
        <a asp-controller="Barbero" asp-action="Dashboard" class="btn btn-outline-primary">
            Actualizar
        </a>
    </div>

    <!-- Tarjetas de estadísticas -->
    <div class="row text-center mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Total Citas</h5>
                    <p class="display-6">@Model.TotalCitas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Pendientes</h5>
                    <p class="display-6">@Model.CitasPendientes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Completadas</h5>
                    <p class="display-6">@Model.CitasCompletadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Canceladas</h5>
                    <p class="display-6">@Model.CitasCanceladas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Ganancias y gráfico en la misma fila -->
    <div class="row mt-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5>Ganancias Totales</h5>
                    <p class="display-6">$@Model.GananciasTotales</p>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="text-center">Citas por Mes</h5>
                    <canvas id="citasPorMesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Botón regresar -->
    <div class="row mt-4 mb-4">
        <div class="col-md-12 text-center">
            <a asp-controller="Barbero" asp-action="Index" class="btn btn-secondary btn-lg">
                ← Regresar al Panel
            </a>
        </div>
    </div>
</div>
