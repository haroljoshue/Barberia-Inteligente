@model ModelosBarberia.LogAgente
@{
    ViewData["Title"] = "Detalle Log Agente";
}

<div class="container my-4" style="max-width:800px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">🤖 Detalle Log Agente</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Volver</a>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-muted mb-0">Información General</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small">Fecha</label>
                    <p class="mb-0 fw-bold">@Model.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Usuario ID</label>
                    <p class="mb-0 fw-bold">@Model.UsuarioId</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Tipo</label>
                    <p class="mb-0">
                        @{
                            // Mapeo dinámico de colores de Bootstrap para los estados del Agente de IA
                            var badge = Model.Tipo switch
                            {
                                ModelosBarberia.Enum.TipoLogAgente.Consulta => "info",
                                ModelosBarberia.Enum.TipoLogAgente.Respuesta => "success",
                                ModelosBarberia.Enum.TipoLogAgente.Error => "danger",
                                ModelosBarberia.Enum.TipoLogAgente.Timeout => "warning",
                                _ => "secondary"
                            };
                        }
                        <span class="badge bg-@badge">@Model.Tipo</span>
                    </p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small">Tokens Usados</label>
                    <p class="mb-0 fw-bold">@Model.TokensUsados</p>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small">Tiempo Respuesta</label>
                    <p class="mb-0 fw-bold">@Model.TiempoRespuestaMs ms</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-muted mb-0">💬 Pregunta</h6>
        </div>
        <div class="card-body">
            <p class="mb-0">@(Model.Pregunta ?? "—")</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 pt-3">
            <h6 class="text-muted mb-0">🤖 Respuesta</h6>
        </div>
        <div class="card-body">
            <p class="mb-0" style="white-space:pre-wrap">@(Model.Respuesta ?? "—")</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="card border-danger border-0 shadow-sm">
            <div class="card-header bg-danger text-white border-0 pt-3">
                <h6 class="mb-0">❌ Error</h6>
            </div>
            <div class="card-body">
                <p class="mb-0 text-danger" style="white-space:pre-wrap">@Model.MensajeError</p>
            </div>
        </div>
    }
</div>