@model IEnumerable<ModelosBarberia.LogAgente>
@{
    ViewData["Title"] = "Logs de Agentes IA";
}

<div class="container-fluid my-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary mb-0">🤖 Logs de Agentes IA</h2>
        <span class="badge bg-secondary fs-6">@Model.Count() registros</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <div class="fs-1">📭</div>
            <p>No hay logs registrados.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th>Usuario</th>
                                <th>Tipo</th>
                                <th>Pregunta</th>
                                <th>Tokens</th>
                                <th>Tiempo (ms)</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.OrderByDescending(l => l.Fecha))
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        <small>@log.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@log.UsuarioId</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@log.Tipo</span>
                                    </td>
                                    <td style="max-width:200px">
                                        <small class="text-truncate d-block" style="max-width:200px"
                                               title="@log.Pregunta">
                                            @log.Pregunta
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@log.TokensUsados</span>
                                    </td>
                                    <td>@log.TiempoRespuestaMs ms</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(log.MensajeError))
                                        {
                                            <span class="badge bg-success">✅ OK</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">❌ Error</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@log.Id"
                                           class="btn btn-sm btn-outline-primary">Ver</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>