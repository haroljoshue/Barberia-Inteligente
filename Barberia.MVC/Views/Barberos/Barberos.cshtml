@model IEnumerable<ModelosBarberia.Barbero>
@{
    ViewData["Title"] = "Barberos";
}

<div class="container section">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-1">Nuestros Barberos</h2>
            <p class="text-muted mb-0">Conoce a nuestro equipo de profesionales</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Registrar Barbero
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="icon">💈</div>
            <h3>No hay barberos registrados</h3>
            <p>Actualmente no existen barberos disponibles en el sistema.</p>
            <img src="https://images.unsplash.com/photo-1512690459411-b0fd1c86b8c8?q=80&w=800&auto=format&fit=crop"
                 alt="Barbería" class="img-rounded mt-3" style="max-height:300px;width:100%;object-fit:cover" />
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var barbero in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100">
                        <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?q=80&w=800&auto=format&fit=crop"
                             alt="Barbero" style="height:200px;object-fit:cover;width:100%" />
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                                     style="width:48px;height:48px;font-size:1.2rem;min-width:48px">
                                    @barbero.Nombre.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <h5 class="card-title mb-0">@barbero.Nombre</h5>
                                    <small class="text-muted">@(barbero.Especialidad ?? "Sin especialidad")</small>
                                </div>
                            </div>

                            <ul class="lista-servicios mb-3">
                                @if (!string.IsNullOrEmpty(barbero.Telefono))
                                {
                                    <li>
                                        <span><i class="bi bi-telephone me-1"></i> Teléfono</span>
                                        <span>@barbero.Telefono</span>
                                    </li>
                                }
                                @if (!string.IsNullOrEmpty(barbero.Email))
                                {
                                    <li>
                                        <span><i class="bi bi-envelope me-1"></i> Email</span>
                                        <span>@barbero.Email</span>
                                    </li>
                                }
                                <li>
                                    <span><i class="bi bi-circle-fill me-1"></i> Estado</span>
                                    @if (barbero.Disponible)
                                    {
                                        <span class="badge bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No disponible</span>
                                    }
                                </li>
                            </ul>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@barbero.Id"
                                       class="btn btn-outline-primary btn-sm w-50">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@barbero.Id"
                                       class="btn btn-outline-danger btn-sm w-50">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Citas" asp-action="Create"
                                   class="btn btn-primary w-100">
                                    Reservar cita
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>