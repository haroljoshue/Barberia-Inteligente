@model IEnumerable<ModelosBarberia.Barbero>

@{
    ViewData["Title"] = "Barberos";
}

<div>

    <h1>Nuestros Barberos</h1>

    @if (User.IsInRole("Admin"))
    {
        <p>
            <a asp-action="Create">
                Registrar Barbero
            </a>
        </p>
    }

</div>

<hr />

@if (TempData["Success"] != null)
{
    <div>
        @TempData["Success"]
    </div>

    <hr />
}

@if (!Model.Any())
{
    <div>

        <h3>No hay barberos registrados</h3>

        <p>
            Actualmente no existen barberos disponibles en el sistema.
        </p>

        <img src="https://images.unsplash.com/photo-1512690459411-b0fd1c86b8c8?q=80&w=1200&auto=format&fit=crop"
             alt="Barbería"
             width="100%" />

    </div>
}
else
{
    @foreach (var barbero in Model)
    {
        <div>

            <img src="https://images.unsplash.com/photo-1621605815971-fbc98d665033?q=80&w=1200&auto=format&fit=crop"
                 alt="Barbero"
                 width="100%" />

            <h2>@barbero.Nombre</h2>

            <p>
                <strong>Especialidad:</strong>
                @(barbero.Especialidad ?? "Sin especialidad")
            </p>

            @if (!string.IsNullOrEmpty(barbero.Telefono))
            {
                <p>
                    <strong>Teléfono:</strong>
                    @barbero.Telefono
                </p>
            }

            @if (!string.IsNullOrEmpty(barbero.Email))
            {
                <p>
                    <strong>Email:</strong>
                    @barbero.Email
                </p>
            }

            <p>
                <strong>Estado:</strong>

                @if (barbero.Disponible)
                {
                    <span>Disponible</span>
                }
                else
                {
                    <span>No disponible</span>
                }
            </p>

            @if (User.IsInRole("Admin"))
            {
                <p>
                    <a asp-action="Edit" asp-route-id="@barbero.Id">
                        Editar
                    </a>

                    |

                    <a asp-action="Delete" asp-route-id="@barbero.Id">
                        Eliminar
                    </a>
                </p>
            }

        </div>

        <hr />
    }
}