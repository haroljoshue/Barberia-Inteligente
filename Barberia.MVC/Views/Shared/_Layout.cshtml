@using System.Security.Claims
@using System.Text.Json
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Barbershop's White City</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS del proyecto -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Barberia.MVC.styles.css" asp-append-version="true" />
</head>
<body>

    <header class="sticky-top">
        <!-- tu navbar aquí -->
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto py-4">
        <!-- tu footer aquí -->
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Cliente"))
    {
        var clienteId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var emailCliente = User.Identity.Name;
        var clienteIdJson = JsonSerializer.Serialize(clienteId);
        var emailClienteJson = JsonSerializer.Serialize(emailCliente);

        <link href="https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css" rel="stylesheet" />

        <!-- Burbuja flotante -->
        <div id="chat-bubble" onclick="toggleChat()" title="Asistente IA">
            <i class="bi bi-chat-dots-fill"></i>
        </div>

        <!-- Contenedor del chat -->
        <div id="chat-container" style="display:none">
            <div id="chat-close-btn" onclick="toggleChat()">
                <i class="bi bi-x-lg"></i>
            </div>
            <div id="n8n-chat-mount"></div>
        </div>

        <script type="module">
            import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js';

            const clienteId = @Html.Raw(clienteIdJson);
            const emailCliente = @Html.Raw(emailClienteJson);

            createChat({
                webhookUrl: 'https://n8n-production-65ed.up.railway.app/webhook/b5311b15-aec7-4f2b-820f-23a9a89093bb/chat',
                mode: 'fullscreen',
                target: '#n8n-chat-mount',
                defaultLanguage: 'es',
                metadata: {
                    clienteId: clienteId,
                    emailCliente: emailCliente,
                    rolSistema: 'Cliente'
                },
                initialMessages: [
                    'Hola 👋, soy el asistente inteligente de la barbería. ¿En qué puedo ayudarte?'
                ],
                i18n: {
                    es: {
                        title: 'Barbería Inteligente',
                        subtitle: 'Agenda y consulta tus citas',
                        inputPlaceholder: 'Escribe tu mensaje...'
                    }
                }
            });
        </script>

        <script>
            function toggleChat() {
                const container = document.getElementById('chat-container');
                const bubble = document.getElementById('chat-bubble');
                const isVisible = container.style.display !== 'none';
                container.style.display = isVisible ? 'none' : 'flex';
                bubble.style.display = isVisible ? 'flex' : 'none';
            }
        </script>
    }
</body>
</html>
