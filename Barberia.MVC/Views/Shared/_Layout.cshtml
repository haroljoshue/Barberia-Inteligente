<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barbershop's Ibarra</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Barberia.MVC.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .text-rojo-barber {
            color: #a81c1c !important; /* Rojo elegante/oscuro */
        }

        .bg-rojo-barber {
            background-color: #a81c1c !important;
        }

        .nav-link-custom {
            color: #495057 !important;
            font-weight: 500;
            transition: color 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #a81c1c !important;
            }

        /* Estilo premium para los botones de paneles dinámicos */
        .btn-panel-rol {
            border: 1px solid #a81c1c;
            color: #a81c1c;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            transition: all 0.2s ease-in-out;
            text-decoration: none;
        }

            .btn-panel-rol:hover {
                background-color: #a81c1c;
                color: #ffffff !important;
                box-shadow: 0 4px 8px rgba(168, 28, 28, 0.15);
            }

        .navbar-nav .nav-link {
            color: #495057 !important;
        }

            .navbar-nav .nav-link:hover {
                color: #a81c1c !important;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-white">

    <header class="border-bottom border-light shadow-sm bg-white sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
            <div class="container-fluid px-5">
                <a class="navbar-brand fw-bold fs-4 text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-rojo-barber">💈</span> Barbershop's <span class="text-rojo-barber">Ibarra</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom px-3" asp-area="" asp-controller="Servicios" asp-action="Index">
                                <i class="bi bi-scissors me-1"></i> Servicios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom px-3" asp-area="" asp-controller="Barberos" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Barberos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom px-3" asp-area="" asp-controller="Home" asp-action="QuienesSomos">
                                <i class="bi bi-info-circle me-1"></i> Quiénes Somos
                            </a>
                        </li>
                    </ul>

                    <div class="navbar-nav d-flex align-items-center gap-3 mt-2 mt-lg-0 border-top border-light pt-2 pt-lg-0">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn-panel-rol" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Panel Admin
                                </a>
                            }

                            @if (User.IsInRole("Barbero"))
                            {
                                <a class="btn-panel-rol" asp-area="" asp-controller="Barbero" asp-action="Index">
                                    <i class="bi bi-calendar-week me-1"></i> Mi Barbería
                                </a>
                            }

                            @if (User.IsInRole("Cliente"))
                            {
                                <a class="btn-panel-rol" asp-area="" asp-controller="Cliente" asp-action="Index">
                                    <i class="bi bi-journal-check me-1"></i> Mis Citas
                                </a>
                            }
                        }

                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-light text-secondary py-4 border-top border-light mt-auto text-center">
        <div class="container-fluid px-5">
            <p class="mb-1 text-dark fw-medium">
                &copy; @DateTime.Now.Year - <span class="text-rojo-barber fw-bold">Barbershop's Ibarra</span>. Todos los derechos reservados.
            </p>
            <small class="text-muted d-block">Estilo, Calidad y Tradición en Ibarra, Ecuador.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>