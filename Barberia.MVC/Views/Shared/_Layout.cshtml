@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Barbershop's White City</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="[https://fonts.googleapis.com](https://fonts.googleapis.com/)">
    <link rel="preconnect" href="[https://fonts.gstatic.com](https://fonts.gstatic.com/)" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS del proyecto -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Barberia.MVC.styles.css" asp-append-version="true" />

</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-modern py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        <i class="bi bi-scissors"></i>
                    </span>
                    <span>Barbershop's <span class="brand-accent">Ibarra</span></span>
                </a>

                <button class="navbar-toggler px-3 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Servicios" asp-action="Servicios">
                                <i class="bi bi-scissors me-1"></i> Servicios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Barberos" asp-action="Barberos">
                                <i class="bi bi-people me-1"></i> Barberos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="QuienesSomos">
                                <i class="bi bi-info-circle me-1"></i> Quiénes Somos
                            </a>
                        </li>
                    </ul>

                    <div class="auth-area">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="role-btn" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Panel Admin
                                </a>
                            }

                            @if (User.IsInRole("Barbero"))
                            {
                                <a class="role-btn" asp-area="" asp-controller="Barbero" asp-action="Index">
                                    <i class="bi bi-calendar-week"></i> Mi Barbería
                                </a>
                            }

                            @if (User.IsInRole("Cliente"))
                            {
                                <a class="role-btn" asp-area="" asp-controller="Cliente" asp-action="Index">
                                    <i class="bi bi-journal-check"></i> Mis Citas
                                </a>
                            }
                        }

                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto py-4">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-center text-md-start">
                <div>
                    <div class="footer-title mb-1">
                        &copy; @DateTime.Now.Year <span class="footer-accent">Barbershop's Ibarra</span>
                    </div>
                    <small>Estilo, calidad y tradición en Ibarra, Ecuador.</small>
                </div>

                <div class="text-muted small">
                    Diseño moderno · Atención profesional · Experiencia premium
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @using System.Security.Claims
    @using System.Text.Json

    @if (User.Identity != null
    && User.Identity.IsAuthenticated
    && User.IsInRole("Cliente"))
    {
        var clienteId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var emailCliente = User.Identity.Name;
        var clienteIdJson = JsonSerializer.Serialize(clienteId);
        var emailClienteJson = JsonSerializer.Serialize(emailCliente);

        <link href="https://cdn.jsdelivr.net/npm/@@n8n/chat/dist/style.css" rel="stylesheet" />

        <!-- Contenedor flotante controlado por nosotros -->
        <div id="chat-bubble" onclick="toggleChat()" title="Asistente IA">
            <i class="bi bi-chat-dots-fill"></i>
        </div>

        <div id="chat-container" style="display:none">
            <div id="chat-close-btn" onclick="toggleChat()">
                <i class="bi bi-x-lg"></i>
            </div>
            <div id="n8n-chat-mount"></div>
        </div>

        <script type="module">
            import { createChat } from 'https://cdn.jsdelivr.net/npm/@@n8n/chat/dist/chat.bundle.es.js';

            const clienteId = @Html.Raw(clienteIdJson);
            const emailCliente = @Html.Raw(emailClienteJson);

                createChat({
                webhookUrl: '...',
                mode: 'embedded',   // usar "embedded" en lugar de fullscreen
                target: '#n8n-chat-mount',
                defaultLanguage: 'es',
                metadata: {
                    clienteId: clienteId,
                    emailCliente: emailCliente,
                    rolSistema: 'Cliente'
                },
                initialMessages: [
                    'Hola, soy el asistente inteligente de la barbería. ¿En qué puedo ayudarte?'
                ],
                i18n: {
                    es: {
                        title: 'Barbería Inteligente',
                        subtitle: 'Agenda y consulta tus citas',
                        inputPlaceholder: 'Escribe tu mensaje...'
                    }
                }
            });

        </script>

        <script>
            function toggleChat() {
                const container = document.getElementById('chat-container');
                const bubble = document.getElementById('chat-bubble');
                const isVisible = container.style.display !== 'none';
                container.style.display = isVisible ? 'none' : 'flex';
                bubble.style.display = isVisible ? 'flex' : 'none';
            }
        </script>
    }
</body>
</html>