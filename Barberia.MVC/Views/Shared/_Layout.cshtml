@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Barbershop's White City</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Barberia.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/@@n8n/chat/dist/style.css" rel="stylesheet" />

    <style>
        :root {
            --barber-red: #8f1d1d;
            --barber-red-dark: #6f1616;
            --barber-bg: #ffffff;
            --barber-text: #1f2937;
            --barber-muted: #6b7280;
            --barber-border: #e5e7eb;
            --barber-soft: #f8f9fa;
            --barber-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        }

        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
            color: var(--barber-text);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .navbar-modern {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--barber-border);
            box-shadow: var(--barber-shadow);
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: .3px;
            color: var(--barber-text) !important;
        }

        .brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--barber-red), var(--barber-red-dark));
            color: #fff;
            box-shadow: 0 8px 20px rgba(143, 29, 29, .25);
        }

        .brand-accent {
            color: var(--barber-red);
        }

        .nav-link-custom {
            position: relative;
            color: var(--barber-text) !important;
            font-weight: 600;
            padding: .85rem 1rem !important;
            transition: all .2s ease;
        }

            .nav-link-custom:hover,
            .nav-link-custom:focus {
                color: var(--barber-red) !important;
            }

            .nav-link-custom::after {
                content: "";
                position: absolute;
                left: 1rem;
                bottom: .55rem;
                width: calc(100% - 2rem);
                height: 2px;
                background: var(--barber-red);
                transform: scaleX(0);
                transform-origin: left;
                transition: transform .22s ease;
                border-radius: 999px;
            }

            .nav-link-custom:hover::after,
            .nav-link-custom:focus::after {
                transform: scaleX(1);
            }

        .role-btn {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            border: 1px solid var(--barber-red);
            color: var(--barber-red);
            font-weight: 700;
            font-size: .9rem;
            padding: .55rem .95rem;
            border-radius: 999px;
            text-decoration: none;
            transition: all .2s ease;
            background: #fff;
            white-space: nowrap;
        }

            .role-btn:hover {
                background: var(--barber-red);
                color: #fff !important;
                box-shadow: 0 10px 18px rgba(143, 29, 29, .18);
                transform: translateY(-1px);
            }

        .auth-area {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        main {
            flex: 1 0 auto;
        }

        .site-footer {
            background: #ffffff;
            border-top: 1px solid var(--barber-border);
            color: var(--barber-muted);
        }

        .footer-title {
            color: var(--barber-text);
            font-weight: 700;
        }

        .footer-accent {
            color: var(--barber-red);
            font-weight: 800;
        }

        .navbar-toggler {
            border: 1px solid var(--barber-border);
            border-radius: 12px;
            box-shadow: none !important;
        }

            .navbar-toggler:focus {
                box-shadow: 0 0 0 .2rem rgba(143, 29, 29, .15) !important;
            }

        @@media (max-width: 991.98px) {
            .auth-area {
                width: 100%;
                flex-direction: column;
                align-items: stretch;
                gap: .5rem;
                padding-top: 1rem;
                margin-top: 1rem;
                border-top: 1px solid var(--barber-border);
            }

            .role-btn {
                justify-content: center;
            }
        }
        /* Chat flotante n8n */
        #n8n-chat {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 9999;
        }

        /* Ajuste visual del botón flotante */
        :root {
            --chat--color-primary: #2dd4bf;
            --chat--color-primary-shade-50: #14b8a6;
            --chat--color-primary-shade-100: #0f766e;
            --chat--window--width: 390px;
            --chat--window--height: 600px;
            --chat--border-radius: 18px;
        }
    </style>
</head>
<body>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-modern py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        <i class="bi bi-scissors"></i>
                    </span>
                    <span>Barbershop's <span class="brand-accent">Ibarra</span></span>
                </a>

                <button class="navbar-toggler px-3 py-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Servicios" asp-action="Index">
                                <i class="bi bi-scissors me-1"></i> Servicios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Barberos" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Barberos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="QuienesSomos">
                                <i class="bi bi-info-circle me-1"></i> Quiénes Somos
                            </a>
                        </li>
                    </ul>

                    <div class="auth-area">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="role-btn" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Panel Admin
                                </a>
                            }

                            @if (User.IsInRole("Barbero"))
                            {
                                <a class="role-btn" asp-area="" asp-controller="Barbero" asp-action="Index">
                                    <i class="bi bi-calendar-week"></i> Mi Barbería
                                </a>
                            }

                            @if (User.IsInRole("Cliente"))
                            {
                                <a class="role-btn" asp-area="" asp-controller="Cliente" asp-action="Index">
                                    <i class="bi bi-journal-check"></i> Mis Citas
                                </a>
                            }
                        }

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto py-4">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-center text-md-start">
                <div>
                    <div class="footer-title mb-1">
                        &copy; @DateTime.Now.Year <span class="footer-accent">Barbershop's Ibarra</span>
                    </div>
                    <small>Estilo, calidad y tradición en Ibarra, Ecuador.</small>
                </div>

                <div class="text-muted small">
                    Diseño moderno · Atención profesional · Experiencia premium
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity != null
        && User.Identity.IsAuthenticated
        && User.IsInRole("Cliente"))
    {
        var clienteId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var emailCliente = User.Identity.Name;

        <link href="https://cdn.jsdelivr.net/npm/@@n8n/chat/dist/style.css" rel="stylesheet" />

        <script type="module">
            import { createChat } from 'https://cdn.jsdelivr.net/npm/@@n8n/chat/dist/chat.bundle.es.js';

            createChat({
                webhookUrl: 'https://n8n-production-65ed.up.railway.app/webhook/b5311b15-aec7-4f2b-820f-23a9a89093bb/chat',
                mode: 'window',
                metadata: {
                    clienteId: '@clienteId',
                    emailCliente: '@emailCliente',
                    rolSistema: 'Cliente'
                },
                initialMessages: [
                    'Hola 👋, soy el asistente inteligente de la barbería. ¿En qué puedo ayudarte?'
                ],
                i18n: {
                    es: {
                        title: 'Barbería Inteligente',
                        subtitle: 'Agenda y consulta tus citas',
                        inputPlaceholder: 'Escribe tu mensaje...'
                    }
                }
            });
        </script>
    }
</body>
</html>