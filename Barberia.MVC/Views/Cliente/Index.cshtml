@model ModelosBarberia.ViewModels.ClienteDashboardViewModel
@{
    ViewData["Title"] = "Mi Panel";
}

<div class="container-fluid my-4 px-4">

    <!-- Encabezado con botón -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
        <div>
            <h2 class="mb-0">Bienvenido, @(Model?.Cliente?.NombreCompleto ?? "Cliente")</h2>
            <small class="text-muted">@Model?.Cliente?.Email</small>
        </div>
        <a asp-action="Agendar" class="btn btn-success">
            Agendar Nueva Cita
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Próxima cita -->
    @if (Model?.ProximaCita != null)
    {
        <div class="alert alert-info border-0 shadow-sm mb-5">
            <strong>Próxima cita:</strong>
            @Model.ProximaCita.FechaHora.ToString("dddd dd 'de' MMMM 'a las' HH:mm")
            con <strong>@(Model.ProximaCita.Barbero?.Nombre ?? "—")</strong>
            — @(Model.ProximaCita.Servicio?.Nombre ?? "—")
            <span class="badge bg-info ms-2">@Model.ProximaCita.Estado</span>
        </div>
    }

    <!-- Estadísticas en fila -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@(Model?.HistorialCitas?.Count ?? 0)</div>
                    <div class="text-muted small">Total Citas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@(Model?.CitasPendientes ?? 0)</div>
                    <div class="text-muted small">Pendientes</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@(Model?.CitasCompletadas ?? 0)</div>
                    <div class="text-muted small">Completadas</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm text-center h-100">
                <div class="card-body">
                    <div class="fs-2 fw-bold">
                        @(Model?.HistorialCitas?.Count(c => c.Estado == ModelosBarberia.Enum.EstadoCita.Cancelada) ?? 0)
                    </div>
                    <div class="text-muted small">Canceladas</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de citas -->
    <div class="card shadow-sm">
        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Historial de Citas</h5>
        </div>
        <div class="card-body p-0">
            @if (Model?.HistorialCitas == null || !Model.HistorialCitas.Any())
            {
                <div class="text-center text-muted py-5">
                    <p>No tienes citas registradas aún.</p>
                    <a asp-action="Agendar" class="btn btn-success">Agendar tu primera cita</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Barbero</th>
                                <th>Servicio</th>
                                <th>Fecha y Hora</th>
                                <th>Estado</th>
                                <th>Observación</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model.HistorialCitas.OrderByDescending(c => c.FechaHora))
                            {
                                <tr>
                                    <td>@(cita.Barbero?.Nombre ?? "—")</td>
                                    <td>@(cita.Servicio?.Nombre ?? "—")</td>
                                    <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            var badge = cita.Estado switch
                                            {
                                                ModelosBarberia.Enum.EstadoCita.Pendiente => "warning",
                                                ModelosBarberia.Enum.EstadoCita.Confirmada => "info",
                                                ModelosBarberia.Enum.EstadoCita.Atendida => "success",
                                                ModelosBarberia.Enum.EstadoCita.Cancelada => "danger",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@badge">@cita.Estado</span>
                                    </td>
                                    <td>@(cita.Observacion ?? "—")</td>
                                    <td>
                                        @if (cita.Estado == ModelosBarberia.Enum.EstadoCita.Pendiente)
                                        {
                                            <form asp-action="Cancelar" method="post" class="d-inline">
                                                <input type="hidden" name="citaId" value="@cita.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('¿Cancelar esta cita?')">
                                                    Cancelar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
