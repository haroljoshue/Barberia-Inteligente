@model ModelosBarberia.Cita

@{
    ViewData["Title"] = "Detalles de la Cita";
}

<div class="container my-5">
    <h2 class="mb-4 text-primary">Detalles de la Cita</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@Model.Cliente.NombreCompleto</dd>

        <dt class="col-sm-3">Barbero</dt>
        <dd class="col-sm-9">@Model.Barbero.Nombre</dd>

        <dt class="col-sm-3">Servicio</dt>
        <dd class="col-sm-9">@Model.Servicio.Nombre</dd>

        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Estado</dd>

        <dt class="col-sm-3">Observación</dt>
        <dd class="col-sm-9">@Model.Observacion</dd>

        <dt class="col-sm-3">Precio Final</dt>
        <dd class="col-sm-9">@Model.PrecioFinal.("C")</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
