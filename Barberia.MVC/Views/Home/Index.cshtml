@model List<ModelosBarberia.Servicio>

@{
    ViewData["Title"] = "Inicio - Barbershop's Ibarra";
}

<div>

    <img src="https://images.unsplash.com/photo-1622287162716-f311baa1a2b8?q=80&w=1400&auto=format&fit=crop"
         alt="Barbería"
         width="100%" />

    <h1>Barbershop's Ibarra</h1>

    <p>
        Tu estilo, nuestra pasión. Descubre lo mejor en cortes,
        afeitados y cuidado personal.
    </p>

    <p>
        <a asp-controller="Cliente" asp-action="Agendar">
            Reservar Ahora
        </a>
    </p>

</div>

<hr />

<div>

    <h2>Nuestro Espacio</h2>

    <img src="https://images.unsplash.com/photo-1517832606299-7ae9b720a186?q=80&w=1200&auto=format&fit=crop"
         alt="Interior barbería"
         width="100%" />

</div>

<hr />

<div>

    <h2>¿Por qué elegirnos?</h2>

    <div>
        <h3>Experiencia Profesional</h3>
        <p>Más de 10 años ofreciendo servicios de barbería.</p>
    </div>

    <div>
        <h3>Puntualidad</h3>
        <p>Valoramos tu tiempo y respetamos cada cita.</p>
    </div>

    <div>
        <h3>Calidad Garantizada</h3>
        <p>Trabajamos con productos y herramientas de calidad.</p>
    </div>

    <div>
        <h3>Reservas en Línea</h3>
        <p>Agenda tu cita de forma rápida y sencilla.</p>
    </div>

</div>