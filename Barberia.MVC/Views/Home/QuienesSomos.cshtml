@{
    ViewData["Title"] = "Quiénes Somos";
}

<!-- Hero -->
<div style="position:relative;height:400px;overflow:hidden">
    <img src="https://images.unsplash.com/photo-1503951914875-452162b0f3f1?q=80&w=1400&auto=format&fit=crop"
         alt="Barbería" style="width:100%;height:100%;object-fit:cover" />
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.55);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2rem">
        <h1 class="text-white fw-bold mb-2" style="font-size:2.5rem">Quiénes Somos</h1>
        <p class="text-white opacity-75 fs-5">Tradición, estilo y confianza en cada corte.</p>
    </div>
</div>

<div class="container my-5">

    <!-- Historia -->
    <div class="row align-items-center g-5 mb-5">
        <div class="col-md-6 order-md-2">
            <img src="https://images.unsplash.com/photo-1585747860715-2ba37e788b70?q=80&w=800&auto=format&fit=crop"
                 alt="Barbero trabajando" class="img-rounded w-100" style="height:280px;object-fit:cover" />
        </div>
        <div class="col-md-6 order-md-1">
            <h2 class="text-primary mb-3">Nuestra Historia</h2>
            <p>Barbershop's Ibarra nació con la visión de crear un espacio donde el cuidado personal se convierta en una experiencia única.</p>
            <p>Desde nuestros inicios hemos combinado la barbería clásica con tendencias modernas para ofrecer un servicio de calidad que supere las expectativas de cada cliente.</p>
        </div>
    </div>

    <hr class="my-5" />

    <!-- Misión y Valores -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title text-primary mb-3">Nuestra Misión</h4>
                    <p class="card-text">Brindar a cada cliente confianza, estilo y una experiencia profesional en cada visita, combinando técnica, pasión y atención personalizada.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="card-title text-primary mb-3">Nuestros Valores</h4>
                    <ul class="lista-servicios">
                        <li>Profesionalismo</li>
                        <li>Innovación</li>
                        <li>Confianza</li>
                        <li>Pasión por el detalle</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <!-- Lo que ofrecemos -->
    <div class="row align-items-center g-5 mb-5">
        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1605497788044-5a32c7078486?q=80&w=800&auto=format&fit=crop"
                 alt="Corte moderno" class="img-rounded w-100" style="height:280px;object-fit:cover" />
        </div>
        <div class="col-md-6">
            <h2 class="text-primary mb-3">Lo que Ofrecemos</h2>
            <p>Cortes clásicos y modernos, fades, taper, perfilado de barba y atención personalizada para cada estilo y personalidad.</p>
            <p>Utilizamos productos de primera línea para garantizar el mejor resultado en cada servicio.</p>
        </div>
    </div>

    <!-- CTA -->
    <div class="card text-white text-center py-5 mt-5"
         style="background:linear-gradient(135deg,var(--color-primary),var(--color-primary-dark));border:none">
        <div class="card-body">
            <h3 class="text-white fw-bold mb-3">¿Listo para tu próximo corte?</h3>
            <p style="color:rgba(255,255,255,0.85)">Estamos listos para atenderte y ayudarte a encontrar el estilo que mejor te representa.</p>
            <a asp-controller="Cliente" asp-action="Agendar" class="btn btn-secondary btn-lg mt-3 fw-bold">
                Reservar Cita
            </a>
        </div>
    </div>

</div>
