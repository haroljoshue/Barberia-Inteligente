@model IEnumerable<ModelosBarberia.ApplicationUser>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container my-5">
    <h2 class="mb-4 text-primary">Gestión de Usuarios</h2>

    <a class="btn btn-success mb-3" asp-action="Create">Crear Usuario</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Activo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.UserName</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.RolSistema</td>
                    <td>@(usuario.Activo ? "Sí" : "No")</td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@usuario.Id">Detalles</a>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@usuario.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@usuario.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
