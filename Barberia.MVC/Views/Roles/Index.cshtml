@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Roles";
}

<div class="container my-5">
    <h2 class="mb-4 text-primary">Gestión de Roles</h2>

    <a class="btn btn-success mb-3" asp-action="Create">Crear Rol</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Nombre del Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rol in Model)
            {
                <tr>
                    <td>@rol.Name</td>
                    <td>
                        <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@rol.Id">Detalles</a>
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@rol.Id">Editar</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@rol.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
