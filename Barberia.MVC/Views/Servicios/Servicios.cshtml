@model IEnumerable<ModelosBarberia.Servicio>
@{
    ViewData["Title"] = "Servicios";
}

<div class="container section">

    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="text-primary mb-2">Nuestros Servicios</h2>
        <p class="text-muted">Elige el servicio que mejor se adapte a tu estilo</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var s in Model.Where(x => x.Activo))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100">
                        <img src="https://images.unsplash.com/photo-1622287162716-f311baa1a2b8?q=80&w=800&auto=format&fit=crop"
                             alt="Servicio" style="height:180px;object-fit:cover;width:100%" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@s.Nombre</h5>
                            <p class="card-text flex-grow-1">
                                @(s.Descripcion ?? "Sin descripción disponible.")
                            </p>

                            <ul class="lista-servicios mb-3">
                                <li>
                                    <span><i class="bi bi-clock me-1"></i> Duración</span>
                                    <span>@s.DuracionMinutos min</span>
                                </li>
                                <li>
                                    <span><i class="bi bi-tag me-1"></i> Precio</span>
                                    <span class="precio">$@s.Precio.ToString("F2")</span>
                                </li>
                            </ul>

                            <a asp-controller="Cliente" asp-action="Agendar"
                               asp-route-servicioId="@s.Id"
                               class="btn btn-primary w-100">
                                Reservar ahora
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="icon">✂️</div>
            <h3>No hay servicios disponibles</h3>
            <p>Actualmente no existen servicios registrados.</p>
            <img src="https://images.unsplash.com/photo-1512690459411-b0fd1c86b8c8?q=80&w=800&auto=format&fit=crop"
                 alt="Barbería" class="img-rounded mt-3" style="max-height:300px;width:100%;object-fit:cover" />
        </div>
    }
</div>