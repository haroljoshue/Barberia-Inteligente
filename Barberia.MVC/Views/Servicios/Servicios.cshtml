@model IEnumerable<ModelosBarberia.Servicio>

@{
    ViewData["Title"] = "Servicios";
}

<div>

    <h1>Nuestros Servicios</h1>

    <p>
        Elige el servicio que mejor se adapte a tu estilo.
    </p>

</div>

<hr />

@if (Model != null && Model.Any())
{
    @foreach (var s in Model)
    {
        <div>

            <img src="https://images.unsplash.com/photo-1622287162716-f311baa1a2b8?q=80&w=1200&auto=format&fit=crop"
                 alt="Servicio de barbería"
                 width="100%" />

            <h2>@s.Nombre</h2>

            <p>
                @(s.Descripcion ?? "Sin descripción disponible.")
            </p>

            @if (s.Precio > 0)
            {
                <p>
                    <strong>Precio:</strong>
                    $@s.Precio.ToString("F2")
                </p>
            }

            <p>
                <a asp-controller="Cliente"
                   asp-action="Agendar"
                   asp-route-servicioId="@s.Id">
                    Reservar
                </a>
            </p>

        </div>

        <hr />
    }
}
else
{
    <div>

        <h3>No hay servicios disponibles</h3>

        <p>
            Actualmente no existen servicios registrados.
        </p>

        <img src="https://images.unsplash.com/photo-1512690459411-b0fd1c86b8c8?q=80&w=1200&auto=format&fit=crop"
             alt="Barbería"
             width="100%" />

    </div>
}